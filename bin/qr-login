#!/usr/bin/env bash
# Mostra come QR l'ultimo indirizzo https comparso nella sessione di Claude,
# così lo apri con il telefono invece di copiarlo dalla console.
#
# Claude Code spezza l'indirizzo lungo con ritorni a capo veri, alla larghezza
# della finestra, e scrive le righe dell'indirizzo senza rientro. Si ricompone
# unendo la riga che comincia con https:// alle righe successive, finché non
# arriva una riga vuota o rientrata (per esempio "  Paste code here...").
set -uo pipefail

if ! testo="$(tmux -L agenti capture-pane -p -J -S -300 -t claude 2>/dev/null)"; then
  echo "La sessione di Claude non è attiva: dal menu, voce 4."
  exit 1
fi

indirizzo="$(printf '%s\n' "$testo" | awk '
  { sub(/[[:space:]]+$/, "") }
  /^https:\/\// { indirizzo = $0; dentro = 1; next }
  dentro && /^[^[:space:]]/ { indirizzo = indirizzo $0; next }
  { dentro = 0 }
  END { print indirizzo }')"

if [ -z "$indirizzo" ]; then
  echo "Nessun indirizzo trovato."
  echo "Entra nella sessione (voce 1), scrivi /login e scegli l'abbonamento Claude,"
  echo "poi esci con Ctrl+B e D e torna qui."
  exit 1
fi

# Prima l'indirizzo, per ultimo il QR: il QR è alto, e così non scorre via.
echo "L'indirizzo per intero:"
echo "$indirizzo"
echo
echo "Inquadra il QR qui sotto con il telefono."
qrencode -t ANSIUTF8 -m 2 "$indirizzo"
