#!/usr/bin/env bash
# Installa pacchetti di Ubuntu, e basta: installa NOME [NOME ...]
#
# È l'unica cosa che agente, e quindi Claude, può fare da amministratore
# senza password: sudo lascia passare solo questo comando (vedi
# /etc/sudoers.d/agenti-kit). Per questo accetta solo nomi di pacchetti:
# niente opzioni, niente percorsi, niente comandi. Tutto il resto che vuole
# l'amministratore passa da "sudo" con la password del proprietario.
set -euo pipefail

if [ "$#" -eq 0 ]; then
  echo "Uso: installa NOME-PACCHETTO [ALTRO-PACCHETTO ...]"
  echo "Installa pacchetti di Ubuntu con apt. Solo nomi di pacchetti, senza opzioni."
  exit 2
fi
if [ "$#" -gt 20 ]; then
  echo "installa: al massimo venti pacchetti alla volta."
  exit 2
fi
for nome in "$@"; do
  # Un nome di pacchetto Debian: minuscole, cifre, punto, più, trattino; mai
  # un trattino all'inizio, così nessuna opzione passa per nome.
  if ! [[ "$nome" =~ ^[a-z0-9][a-z0-9.+-]*$ ]]; then
    echo "installa: '$nome' non è un nome di pacchetto. Solo lettere minuscole, cifre, punto, più e trattino."
    exit 2
  fi
done

if [ "$(id -u)" -ne 0 ]; then
  # Rilanciato da root attraverso sudo, senza password: vale solo per questo
  # programma. Se sudo lo rifiuta, la regola del kit non c'è.
  exec sudo -n -- /usr/local/bin/installa "$@"
fi

export DEBIAN_FRONTEND=noninteractive
APT=(apt-get -o DPkg::Lock::Timeout=600)
# L'elenco dei pacchetti si aggiorna se è vecchio di più di dodici ore.
if [ -z "$(find /var/lib/apt/lists -maxdepth 1 -name '*Packages' -mmin -720 2>/dev/null | head -n 1)" ]; then
  "${APT[@]}" update -q
fi
echo "=== installa $* ($(date -Is), chiesto da ${SUDO_USER:-root})" >> /var/log/agenti-kit-installa.log
"${APT[@]}" install -y -q -- "$@" 2>&1 | tee -a /var/log/agenti-kit-installa.log
exit "${PIPESTATUS[0]}"
