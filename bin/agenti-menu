#!/usr/bin/env bash
# Il menu della console: le operazioni del corso senza scrivere comandi.
set -uo pipefail

PLUGIN_TELEGRAM="telegram@claude-plugins-official"
MARKETPLACE="anthropics/claude-plugins-official"

attendi() {
  echo
  read -r -p "Premi Invio per tornare al menu. " _
}

completa_plugin() {
  claude plugin marketplace add "$MARKETPLACE" >/dev/null 2>&1 || true
  if claude plugin install "$PLUGIN_TELEGRAM" -s user -y; then
    echo "Plugin Telegram installato."
  else
    echo "Il plugin non si è installato. Scrivilo nello spogliatoio."
  fi
}

while true; do
  clear
  cat <<FINE
Agenti che non dormono: la tua macchina ($(cat /usr/local/share/agenti-kit/VERSIONE 2>/dev/null || echo 'kit'))

  1  Entra nella sessione di Claude
  2  Controllo salute
  3  QR per il login
  4  Riavvia la sessione di Claude
  5  Completa l'installazione del plugin Telegram
  0  Esci nella shell

Dalla sessione di Claude si torna qui con Ctrl+B e poi D:
la sessione resta accesa.
FINE
  read -r -p "Scelta: " scelta
  case "$scelta" in
    1) tmux attach -t claude || { echo "La sessione non è accesa: scegli 4."; attendi; } ;;
    2) salute-base; attendi ;;
    3) qr-login; attendi ;;
    4) riavvia-claude; attendi ;;
    5) completa_plugin; attendi ;;
    0) exit 0 ;;
    *) ;;
  esac
done
