#!/usr/bin/env bash
# Apre la sessione tmux "claude" nella cartella di lavoro.
# La lancia il servizio claude-sessione; a mano si usa riavvia-claude.
set -euo pipefail

export PATH="$HOME/.bun/bin:$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin"
cd "$HOME/lavoro"

argomenti=()
# Telegram solo quando il token del bot è stato inserito (prepara-notte).
if [ -s "$HOME/.claude/channels/telegram/.env" ]; then
  argomenti+=(--channels plugin:telegram@claude-plugins-official)
fi

# Un socket tmux solo per questa sessione: gli altri tmux dello studente non
# tengono in vita il server quando Claude si chiude, e il servizio lo riavvia.
tmux -L agenti kill-server 2>/dev/null || true
exec tmux -L agenti new-session -d -s claude -c "$HOME/lavoro" claude "${argomenti[@]}"
