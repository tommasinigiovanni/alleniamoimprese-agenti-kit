# Profilo dell'utente agente (kit del corso Agenti che non dormono).
[ -f "$HOME/.profile" ] && . "$HOME/.profile"
export PATH="$HOME/.bun/bin:$HOME/.local/bin:$PATH"
export LANG="${LANG:-C.UTF-8}"

# Sulla console della macchina si apre il menu del corso.
if [ "$(tty)" = /dev/tty1 ]; then
  agenti-menu
fi
